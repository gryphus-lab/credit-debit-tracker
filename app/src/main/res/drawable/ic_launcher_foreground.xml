<?xml version="1.0" encoding="utf-8"?>
<!--
  Credit · Debit launcher foreground.

  A white rounded "ledger card" sits in the adaptive-icon safe zone (content
  kept within the central ~66dp so the OS mask never clips it). On the card:
  a green up-arrow (money in / credit) on the left and a red down-arrow
  (money out / debit) on the right - a compact, legible symbol for tracking
  balances. Colours match the app: credit = Material green, debit = error red.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ledger card: white rounded rectangle, centered in the safe zone. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,34 h40 a6,6 0 0 1 6,6 v28 a6,6 0 0 1 -6,6 h-40 a6,6 0 0 1 -6,-6 v-28 a6,6 0 0 1 6,-6 z" />

    <!-- Credit (money in): green up-arrow, left half. -->
    <path
        android:fillColor="#2E7D32"
        android:pathData="M43,68 v-11 h-5 l7.5,-9 l7.5,9 h-5 v11 z" />

    <!-- Debit (money out): red down-arrow, right half. -->
    <path
        android:fillColor="#C62828"
        android:pathData="M62,40 v11 h5 l-7.5,9 l-7.5,-9 h5 v-11 z" />

</vector>
